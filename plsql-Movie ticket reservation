CREATE OR REPLACE FUNCTION fn_total_amount
(
p_show_no NUMBER,
p_tickets NUMBER
)
RETURN NUMBER
IS
 
v_price cinema_movies.ticket_price%TYPE;
v_amount NUMBER;
 
BEGIN
 
SELECT m.ticket_price
INTO v_price
FROM cinema_movies m,
movie_shows s
WHERE m.film_id=s.film_id
AND s.show_no=p_show_no;
 
v_amount := v_price * p_tickets;
 
RETURN v_amount;
 
END;
/



CREATE OR REPLACE PROCEDURE pr_book_ticket
(
p_reservation_id NUMBER,
p_viewer_id NUMBER,
p_show_no NUMBER,
p_tickets NUMBER
)
IS
 
v_available NUMBER;
 
BEGIN
 
SELECT seats_left
INTO v_available
FROM movie_shows
WHERE show_no=p_show_no;
 
IF p_tickets > v_available THEN
 
DBMS_OUTPUT.PUT_LINE(
'Not Enough Seats');
 
ELSE
 
INSERT INTO ticket_reservations
(
reservation_id,
viewer_id,
show_no,
no_of_tickets,
reservation_date,
booking_status
)
VALUES
(
p_reservation_id,
p_viewer_id,
p_show_no,
p_tickets,
SYSDATE,
'CONFIRMED'
);
 
UPDATE movie_shows
SET seats_left =
seats_left - p_tickets
WHERE show_no = p_show_no;
 
COMMIT;
 
DBMS_OUTPUT.PUT_LINE(
'Booking Successful');
 
END IF;
 
EXCEPTION
 
WHEN NO_DATA_FOUND THEN
DBMS_OUTPUT.PUT_LINE(
'Show Not Found');
 
WHEN OTHERS THEN
DBMS_OUTPUT.PUT_LINE(SQLERRM);
 
END;
/


CREATE OR REPLACE PROCEDURE pr_make_payment
(
p_payment_id NUMBER,
p_reservation_id NUMBER
)
IS
 
v_show NUMBER;
v_tickets NUMBER;
v_amount NUMBER;
 
BEGIN
 
SELECT show_no,
no_of_tickets
INTO v_show,
v_tickets
FROM ticket_reservations
WHERE reservation_id =
p_reservation_id;
 
v_amount :=
fn_total_amount(
v_show,
v_tickets);
 
INSERT INTO payment_details
VALUES(
p_payment_id,
p_reservation_id,
v_amount
);
 
COMMIT;
 
DBMS_OUTPUT.PUT_LINE(
'Payment Success');
 
DBMS_OUTPUT.PUT_LINE(
'Amount = '||v_amount);
 
END;
/


CREATE OR REPLACE PROCEDURE pr_cancel_ticket
(
p_reservation_id NUMBER
)
IS
 
v_show NUMBER;
v_tickets NUMBER;
 
BEGIN
 
SELECT show_no,
no_of_tickets
INTO v_show,
v_tickets
FROM ticket_reservations
WHERE reservation_id =
p_reservation_id;
 
UPDATE movie_shows
SET seats_left =
seats_left + v_tickets
WHERE show_no = v_show;
 
DELETE FROM ticket_reservations
WHERE reservation_id =
p_reservation_id;
 
COMMIT;
 
DBMS_OUTPUT.PUT_LINE(
'Ticket Cancelled');
 
END;
/


CREATE TABLE reservation_audit
(
reservation_id NUMBER,
audit_date DATE
);
 

CREATE OR REPLACE TRIGGER trg_reservation_audit
AFTER INSERT
ON ticket_reservations
FOR EACH ROW
BEGIN
 
INSERT INTO reservation_audit
VALUES(
:NEW.reservation_id,
SYSDATE
);
 
END;
/


