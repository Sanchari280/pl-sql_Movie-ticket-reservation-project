
CREATE TABLE cinema_movies
(
film_id NUMBER PRIMARY KEY,
film_name VARCHAR2(100),
ticket_price NUMBER
);


CREATE TABLE movie_shows
(
show_no NUMBER PRIMARY KEY,
film_id NUMBER,
show_date DATE,
seats_left NUMBER,
 
FOREIGN KEY(film_id)
REFERENCES cinema_movies(film_id)
);


CREATE TABLE viewers
(
viewer_id NUMBER PRIMARY KEY,
viewer_name VARCHAR2(100),
mobile_no VARCHAR2(15)
);



CREATE TABLE ticket_reservations
(
reservation_id NUMBER PRIMARY KEY,
viewer_id NUMBER,
show_no NUMBER,
no_of_tickets NUMBER,
reservation_date DATE,
booking_status VARCHAR2(20),
 
FOREIGN KEY(viewer_id)
REFERENCES viewers(viewer_id),
 
FOREIGN KEY(show_no)
REFERENCES movie_shows(show_no)
);



CREATE TABLE payment_details
(
payment_id NUMBER PRIMARY KEY,
reservation_id NUMBER,
amount_paid NUMBER,
 
FOREIGN KEY(reservation_id)
REFERENCES ticket_reservations(reservation_id)
);



